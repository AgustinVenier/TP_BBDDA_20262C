	partition 'Reportes.vw_Plantillas' = m
		mode: import
		source =
				let
				    Origen = Sql.Database(Servidor, BaseDeDatos),
				    Reportes_vw_Plantillas = Origen{[Schema="Reportes",Item="vw_Plantillas"]}[Data],
				    ConJugador = Table.AddColumn(Reportes_vw_Plantillas, "jugador", each [nombre] & " " & [apellido], type text),
				    ConEstado = Table.AddColumn(ConJugador, "estado", each if [activo] then "Convocado" else "Dado de baja", type text),
				    // jugador se ordena por puesto y dorsal, como el XML. Cada nombre lleva un solo
				    // orden_jugador (el menor), porque sortByColumn no admite dos órdenes para el
				    // mismo valor; dentro de una selección el nombre no se repite.
				    ConOrden = Table.AddColumn(ConEstado, "orden", each
				        (if [posicion_habitual] = "ARQUERO" then 1
				         else if [posicion_habitual] = "DEFENSOR" then 2
				         else if [posicion_habitual] = "MEDIOCAMPISTA" then 3
				         else 4) * 100 + [dorsal], Int64.Type),
				    OrdenPorNombre = Table.Group(ConOrden, {"jugador"}, {{"orden_jugador", each List.Min([orden]), Int64.Type}}),
				    Claves = Table.RenameColumns(OrdenPorNombre, {{"jugador", "jugador_clave"}}),
				    ConOrdenJugador = Table.Join(ConOrden, "jugador", Claves, "jugador_clave"),
				    Resultado = Table.RemoveColumns(ConOrdenJugador, {"orden", "jugador_clave"})
				in
				    Resultado

	annotation PBI_ResultType = Table

