table Ocupacion
	lineageTag: 0553726b-31f6-5d34-9c6a-7c5dfa6e7cbe

	measure 'Ingresos USD' = SUM(Ocupacion[costo_usd])
		formatString: $ #,0
		lineageTag: 281859fc-560e-559b-abf7-91e3ba149b76

	measure Espacios = COUNTROWS(Ocupacion)
		formatString: 0
		lineageTag: 97cf28d4-aea3-5a59-a436-ba336cb65cfe

	measure 'Espacios ocupados' = CALCULATE(COUNTROWS(Ocupacion), Ocupacion[ocupado] = TRUE())
		formatString: 0
		lineageTag: dcef5e9e-86d4-51ca-b41b-9dbde83aa4e1

	measure '% Ocupación' = DIVIDE([Espacios ocupados], [Espacios])
		formatString: 0.0%
		lineageTag: 25fc1376-4f48-53c2-ab5f-36c75e125cba

	measure 'Espacio 1' = IF(HASONEVALUE(Partidos[id_partido]), CALCULATE(IF(NOT ISEMPTY(Ocupacion), COALESCE(MAX(Ocupacion[anunciante]), "(libre)")), Ocupacion[numero_espacio] = 1))
		lineageTag: ea3318b0-1031-44d2-b370-3ffd70506b20

	measure 'Espacio 2' = IF(HASONEVALUE(Partidos[id_partido]), CALCULATE(IF(NOT ISEMPTY(Ocupacion), COALESCE(MAX(Ocupacion[anunciante]), "(libre)")), Ocupacion[numero_espacio] = 2))
		lineageTag: 275e7ec6-20bd-403d-996b-e785a9735c84

	measure 'Espacio 3' = IF(HASONEVALUE(Partidos[id_partido]), CALCULATE(IF(NOT ISEMPTY(Ocupacion), COALESCE(MAX(Ocupacion[anunciante]), "(libre)")), Ocupacion[numero_espacio] = 3))
		lineageTag: 9650d37a-69f5-4ef7-bc35-65ffebfcf2db

	measure 'Espacio 4' = IF(HASONEVALUE(Partidos[id_partido]), CALCULATE(IF(NOT ISEMPTY(Ocupacion), COALESCE(MAX(Ocupacion[anunciante]), "(libre)")), Ocupacion[numero_espacio] = 4))
		lineageTag: a4089865-0f34-46c2-9168-824ac7caf5da

	measure Anunciantes = DISTINCTCOUNTNOBLANK(Ocupacion[id_anunciante])
		formatString: 0
		lineageTag: 3c1f6b2e-8d4a-4f0e-9b57-6e2a1d9c4f80

