model Model
	culture: es-AR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-AR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Servidor", "BaseDeDatos", "Reportes.vw_Resultados", "Reportes.vw_Sedes", "Reportes.vw_Goles", "Reportes.vw_Tarjetas", "Reportes.vw_SuspensionesActivas", "Reportes.vw_DesignacionesArbitrales", "Reportes.vw_OcupacionPublicitaria", "Reportes.vw_IngresosPublicitariosPorMoneda", "Reportes.vw_PrimeTimePorMercado", "Reportes.vw_TablaPosiciones", "Reportes.vw_CuadroEliminacion", "Reportes.vw_Plantillas", "Reportes.vw_Arbitros"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Reportes.vw_Resultados'
ref table 'Reportes.vw_Sedes'
ref table 'Reportes.vw_Goles'
ref table 'Reportes.vw_Tarjetas'
ref table 'Reportes.vw_OcupacionPublicitaria'
ref table 'Reportes.vw_IngresosPublicitariosPorMoneda'
ref table 'Reportes.vw_PrimeTimePorMercado'
ref table 'Reportes.vw_TablaPosiciones'
ref table 'Reportes.vw_CuadroEliminacion'
ref table 'Reportes.vw_SuspensionesActivas'
ref table 'Reportes.vw_DesignacionesArbitrales'
ref table 'Reportes.vw_Plantillas'
ref table 'Reportes.vw_Arbitros'

ref cultureInfo es-AR

